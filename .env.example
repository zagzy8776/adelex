# Set these as private server-side variables in Vercel.
DATABASE_URL=
ADMIN_OWNER_EMAIL=
# Generate with: openssl rand -hex 32
ADMIN_ACCESS_KEY=

# Transactional email (Production): configure in Vercel, never commit real keys.
RESEND_API_KEY=
EMAIL_FROM=
# Optional monitored mailbox for customer replies
EMAIL_REPLY_TO=
# Random private secret used by Vercel Cron, e.g. openssl rand -hex 32
CRON_SECRET=

# Optional: replace the community map tiles with a licensed provider (JSON
# array). Public by design — it reaches the browser. Use VITE_TILE_PROVIDERS
# instead on the Vite/vinext build.
# NEXT_PUBLIC_TILE_PROVIDERS=[{"id":"maptiler","url":"https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=KEY","attribution":"&copy; MapTiler"}]
